# ==============================================================================
# Project Mu Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual settings.
# ==============================================================================

# --- AI & Vision Services ---
# Google Gemini API Key (used for vision extraction and newsroom LLM swarms)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCode Go API key (newsroom/pipeline OpenAI-compatible calls; `deepseek` is an alias for Go)
# Console > Account > Personal API keys (oc_sk_...)
OPENCODE_GO_API_KEY=your_opencode_go_key_here
# Optional base URL for Go; defaults to the Go OpenAI-compatible path (.../inference/go/openai/v1)
OPENCODE_GO_BASE_URL=

# --- Database & Storage ---
# Canonical Temporal PostgreSQL connection string
DATABASE_URL=host=localhost dbname=madden user=postgres password=postgres

# Redis URL (used for legacy events / caching if enabled)
REDIS_URL=redis://localhost:6379/0

# --- Web Backend & Debug Security ---
# Secret token required to authenticate with the #debug endpoints and trigger runs
DEBUG_TOKEN=your_secure_debug_token_here

# --- Phone Notifications (ntfy) ---
# ntfy topic name to receive weekly run alerts and pipeline progress notifications
NTFY_TOPIC=your-unique-ntfy-topic
NTFY_SERVER=https://ntfy.sh

# --- Console Capture (macOS + chiaki-ng) ---
# Remote Play host credentials if running Madden PS5 capture
CHIAKI_HOST=PS5-Console
CHIAKI_HOST_IP=192.168.1.100

# --- PC Migration & Franchise Save Watcher ---
# Directory containing PC franchise saves (for pipeline/watch_save.py)
# MADDEN_SAVES_DIR=/path/to/Madden/Saves

# --- Local LLM Provider (Optional) ---
# OLLAMA_HOST=http://localhost:11434
